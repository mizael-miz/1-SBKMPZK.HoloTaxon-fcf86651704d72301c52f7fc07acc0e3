{
  "name": "obsidian-holotaxon",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-driven graph API for the HoloTaxon Obsidian plugin.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:entrypoint": "node --test tests/entrypoint-smoke.test.mjs",
    "protocol:validate": "node scripts/validate-stages.mjs",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
