{
  "name": "obsidian-holotaxon",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-driven graph API for the HoloTaxon Obsidian plugin.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
