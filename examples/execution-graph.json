  "entities": {
    "L2-POP-EVOLUTIONARY": {
      "id": "L2-POP-EVOLUTIONARY",
      "entity_type": "Layer2Concept",
      "axis": "L2",
      "label": "Evolutionary population profile",
      "revision": 1,
      "status": "active",
      "concept_bindings": [],
      "created_at": "2026-10-24T00:00:00.000Z",
      "updated_at": "2026-10-24T00:00:00.000Z",
      "properties": {
        "concept_kind": "population_definition",
        "lifecycle": "active",
        "applies_to_entity_types": ["Population"],
        "applies_to_relation_types": ["GENE_FLOW_WITH", "REPRODUCTIVE_BOUNDARY_WITH"],
        "extends_concept_ids": [],
        "requires_concept_ids": [],
        "excludes_concept_ids": [],
        "definition_version": "1.0.0",
        "rationale": "Population states analysed as evolutionary units must declare a gene-flow model. This profile does not determine species boundaries by itself.",
        "applicability": {
          "description": "Applies to evolutionary population analyses; populations may carry separate ecological profiles as well.",
          "required_property_values": { "population_basis": "evolutionary" }
        },
        "effects": {
          "entities": {
            "add_fields": {
              "gene_flow_model": {
                "type": "string",
                "required": true,
                "enum": ["none_detected", "limited", "recurrent", "continuous", "unknown"],
                "description": "Qualitative summary of gene exchange; must not be substituted for a quantitative estimate."
              }
            },
            "required_fields": ["gene_flow_model"],
            "constraints": [
              { "field": "population_basis", "operator": "equals", "value": "evolutionary", "message": "Evolutionary population profile requires population_basis=evolutionary." }
            ],
            "allow_outgoing_relations": ["GENE_FLOW_WITH", "REPRODUCTIVE_BOUNDARY_WITH"],
            "allow_incoming_relations": ["GENE_FLOW_WITH", "REPRODUCTIVE_BOUNDARY_WITH"]
          },
          "relations": {
            "add_property_fields": {
              "exchange_scope": { "type": "string", "required": true, "description": "Spatial, temporal, or genomic scope of the exchange assertion." }
            },
            "required_property_fields": ["exchange_scope"]
          },
          "add_relation_types": [
            {
              "id": "REPRODUCTIVE_BOUNDARY_WITH",
              "description": "A scoped assertion of a reproductive boundary between populations without presupposing complete isolation or species rank.",
              "from_types": ["Population"],
              "to_types": ["Population"],
              "symmetric": true,
              "allow_self_loop": false,
              "properties": {
                "barrier_kind": { "type": "string", "required": true, "enum": ["prezygotic", "postzygotic", "ecological", "temporal", "mixed", "unknown"] },
                "permeability": { "type": "string", "required": true, "enum": ["complete_in_sample", "strong", "partial", "context_dependent", "unknown"] }
              },
              "required_properties": ["barrier_kind", "permeability"]
            }
          ]
        }
      }
    },
